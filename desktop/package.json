{
  "name": "@framation/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && wait-on http-get://127.0.0.1:4200 && cross-env FRAMATION_DEV_SERVER_URL=http://127.0.0.1:4200 electron dist/main.js",
    "launch": "electron dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
