{
  "name": "stickmations",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop 2D stick-figure animation software.",
  "author": {
    "name": "Adam Almounayar",
    "email": "adamalmounayar@hotmail.com",
    "url": "https://stickmations.com"
  },
  "homepage": "https://stickmations.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/adxdits/stickmations.git"
  },
  "main": "desktop/dist/main.js",
  "workspaces": [
    "engine",
    "desktop",
    "frontend",
    "website"
  ],
  "scripts": {
    "dev": "npm run build --workspace @stickmations/engine && concurrently --kill-others-on-fail --names engine,frontend,desktop \"npm run watch --workspace @stickmations/engine\" \"npm run start --workspace @stickmations/frontend\" \"npm run dev --workspace @stickmations/desktop\"",
    "dev:website": "npm run start --workspace @stickmations/website",
    "start": "npm run build:app && npm run launch --workspace @stickmations/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:app": "npm run build --workspace @stickmations/engine && npm run build --workspace @stickmations/desktop && npm run build --workspace @stickmations/frontend",
    "test": "npm run test:release && npm run test --workspace @stickmations/engine && npm run test --workspace @stickmations/frontend -- --watch=false && npm run test --workspace @stickmations/website -- --watch=false",
    "test:release": "node --test scripts/*.spec.mjs",
    "typecheck": "npm run typecheck --workspace @stickmations/engine && npm run typecheck --workspace @stickmations/desktop",
    "check": "npm run build && npm run test && npm run typecheck",
    "pack": "npm run build:app && electron-builder --dir --publish never",
    "dist": "npm run build:app && electron-builder --publish never",
    "dist:mac": "npm run build:app && electron-builder --mac --publish never",
    "dist:win": "npm run build:app && electron-builder --win --publish never",
    "dist:linux": "npm run build:app && electron-builder --linux --publish never",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "build": {
    "appId": "com.stickmations.app",
    "productName": "Stickmations",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright (c) 2026 adxdits",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/dist/**/*",
      "desktop/package.json",
      "frontend/dist/frontend/browser/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "branding/icon.png"
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "LICENSE",
          "ffmpeg.LICENSE",
          "ffmpeg.README",
          "package.json"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "executableName": "stickmations",
      "maintainer": "Adam Almounayar <adamalmounayar@hotmail.com>",
      "synopsis": "Desktop 2D stick-figure animation editor",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10.9 <11"
  },
  "packageManager": "npm@10.9.0"
}
