{
  "name": "framation",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop 2D stick-figure animation software.",
  "author": "adxdits",
  "main": "desktop/dist/main.js",
  "workspaces": [
    "engine",
    "desktop",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run build --workspace @framation/engine && concurrently --kill-others-on-fail --names engine,frontend,desktop \"npm run watch --workspace @framation/engine\" \"npm run start --workspace @framation/frontend\" \"npm run dev --workspace @framation/desktop\"",
    "start": "npm run build && npm run launch --workspace @framation/desktop",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @framation/engine && npm run test --workspace @framation/frontend -- --watch=false",
    "typecheck": "npm run typecheck --workspace @framation/engine && npm run typecheck --workspace @framation/desktop",
    "check": "npm run build && npm run test && npm run typecheck",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.framation.app",
    "productName": "Framation",
    "copyright": "Copyright (c) 2026 adxdits",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/dist/**/*",
      "desktop/package.json",
      "frontend/dist/frontend/browser/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "LICENSE",
          "ffmpeg.LICENSE",
          "ffmpeg.README",
          "package.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10.9 <11"
  },
  "packageManager": "npm@10.9.0"
}
